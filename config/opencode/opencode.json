{
    "$schema": "https://opencode.ai/config.json",
    "shell": "/bin/bash",
    "update": "notify",
    "websearch": {
        "provider": "random"
    },
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 15000
        },
        "buffer": 20000
    },
    "formatter": {
        "prettier": {
            "command": ["npx", "-y", "prettier", "--write", "$FILE"],
            "extensions": [".mdx"]
        }
    },
    "lsp": true,
    "references": {},
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp"
            },
            "gh_grep": {
                "type": "remote",
                "url": "https://mcp.grep.app"
            },
            "sequential-thinking": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@modelcontextprotocol/server-sequential-thinking"
                ]
            }
        }
    }
}
