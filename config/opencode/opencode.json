{
    "$schema": "https://opencode.ai/config.json",
    "experimental": {
        "todo": true
    },
    "shell": "/bin/bash",
    "update": "notify",
    "websearch": {
        "provider": "random"
    },
    "compaction": {
        "auto": true,
        "keep": {
            "tokens": 15000
        },
        "buffer": 20000
    },
    "formatter": {
        "prettier": {
            "command": ["npx", "-y", "prettier", "--write", "$FILE"],
            "extensions": [".mdx"]
        }
    },
    "lsp": true,
    "tool_output": {
        "max_lines": 1000,
        "max_bytes": 16384
    },
    "references": {
        "dotfiles": {
            "path": "~/.dotfiles",
            "description": "The global layer of this machine's dotfiles: AGENTS.md holds the rules that apply in every project, doc/ai.md the opencode configuration, and config/opencode the global plugins. Read it when a question is about this machine's setup rather than about the project in front of you."
        }
    },
    "mcp": {
        "servers": {
            "context7": {
                "type": "remote",
                "url": "https://mcp.context7.com/mcp"
            },
            "gh_grep": {
                "type": "remote",
                "url": "https://mcp.grep.app"
            },
            "sequential-thinking": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@modelcontextprotocol/server-sequential-thinking"
                ]
            }
        }
    }
}
